root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Legal text: trailing whitespace is meaningful nowhere, but hard-wrapping is. Leave
# wrapping to the author — a diff-per-sentence layout is what makes clause review
# readable in a pull request.
[*.md]
max_line_length = off
trim_trailing_whitespace = true

[*.{json,yml,yaml,mjs}]
indent_size = 2

[*.txt]
insert_final_newline = true
